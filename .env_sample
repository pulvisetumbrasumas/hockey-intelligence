# Hockey Intelligence - Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
DATABASE_URL=sqlite+aiosqlite:///./hockey_intelligence.db

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=420
OLLAMA_KEEP_ALIVE=10m

# NHL Data Sources
NHL_STATS_API_BASE=https://api.nhle.com/stats/rest/en
NHL_WEB_API_BASE=https://api-web.nhle.com/v1

# Data Seeding (comma-separated season IDs)
DATA_SEED_SEASONS=20152016,20162017,20172018,20182019,20192020,20202021,20212022,20222023,20232024,20242025

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
