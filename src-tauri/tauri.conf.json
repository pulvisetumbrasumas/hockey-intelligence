{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hockey Intelligence",
  "version": "0.1.0",
  "identifier": "io.hockeyintelligence",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "windows": [
      {
        "title": "Hockey Intelligence",
        "label": "main",
        "url": "http://127.0.0.1:8000",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Sports",
    "targets": ["appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "sidecar/hockey-server": ""
    },
    "shortDescription": "Cinematic, data-driven NHL hockey intelligence platform",
    "longDescription": "Hockey Intelligence — a cinematic, data-driven NHL hockey platform: standings, leaders, player & team history, championship records, and a database-grounded AI assistant. Runs its own local API."
  }
}